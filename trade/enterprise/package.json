{
  "name": "@deepseek-ai/dsh-trade-enterprise",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "npm run build && npm run test:sites && node --test test/*.test.mjs",
    "test:sites": "vitest run --config vitest.sites.config.ts",
    "test:sites:model": "node --test test/sites-model.e2e.mjs",
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json"
  },
  "dependencies": {
    "esbuild": "0.28.1",
    "file-type": "21.3.4",
    "officeparser": "7.8.0",
    "range-parser": "1.3.0",
    "zod": "4.1.12"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@types/range-parser": "1.2.7",
    "@types/react": "18.3.1",
    "fflate": "0.8.3",
    "react": "18.3.1"
  },
  "overrides": {
    "pdfjs-dist": "6.2.108"
  }
}
